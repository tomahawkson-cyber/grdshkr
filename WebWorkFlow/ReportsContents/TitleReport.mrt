  <Script>using System;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class Report : Stimulsoft.Report.StiReport
    {
        public Report()        {
            this.InitializeComponent();
        }
		public static string ConvertMinutesToTime(decimal inputParameter)
		{		
			int input= int.Parse(inputParameter.ToString());
			input= ((input / 60) * 100) + (input % 60);
			if (input.ToString().Length &gt; 2)
			{
				return input.ToString().Insert(input.ToString().Length - 2, ":");
			}
			return input.ToString();
		}
		public static string ConvertMinutesToHours(int inputParameter)
		{
			int input= (inputParameter / 60);
			return input.ToString();
		}	
		
		public static string ConvertMinutesToHoursForSum(object inputParameter)
		{
			if(inputParameter == null)
				return "";
			int input= int.Parse(inputParameter.ToString());
			
			int hours= (input / 60);
			
			if((input%60)&gt;30)
				hours=hours+1;
			if(hours&lt;=0)
				return "";
			return hours.ToString();
		}	
		
		
		public static string ConvertTimeToMinutes(object inputParameter)
		{
			if(inputParameter == null)
				return "";
			int input= int.Parse(inputParameter.ToString());
			
			var result=(((input/100)*60)+(input%100));
			if(result&lt;=0)
				return "";
			return result.ToString();
		}
	
		public static string DayFormatPersent(object inputParameter,object r2t)
		{
			if(inputParameter == null)
				return "";
			string tf=r2t.ToString();
			if(tf=="")
				return inputParameter.ToString();
			
			return inputParameter.ToString()+" روز("+tf+"%)";
		}
		public static string DayFormat(object inputParameter,object r2t)
		{
			if(inputParameter == null)
				return "";
			string tf=TimeFormat(r2t);
			if(tf=="")
				return inputParameter.ToString();
			
			return inputParameter.ToString()+" روز("+tf+")";
		}
		public static string DayFormat(object inputParameter)
		{
			if(inputParameter == null)
				return "";
					
			return inputParameter.ToString()+"روز";
		}
		public static string TimeFormat(object inputParameter)
		{
			if(inputParameter == null)
				return "";
			int input= int.Parse(inputParameter.ToString());
			if(input==0)
				return "";
			
			string inputStr=input.ToString();
			
			if (inputStr.Length == 1)
				inputStr="00"+inputStr;
				
			else if (inputStr.Length == 2)
				inputStr="0"+inputStr;
			
			if (inputStr.Length &gt;= 2)
			{
				return inputStr.Insert(inputStr.Length - 2, ":");
			}
			return input.ToString();
		}
		public static string TimeFormat(object inputParameter,object percent)
		{
			if(inputParameter == null)
				return "";
			return	TimeFormat(inputParameter)+"("+percent.ToString()+"% )";
		}
		
        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}
</Script>
